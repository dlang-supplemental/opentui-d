# Allow-list: ignore everything, then un-ignore tracked paths.
*
!*/

!.gitignore
!LICENSE
!README.adoc
!README.md
!CHANGELOG.adoc
!MEMORIES.md
!dub.sdl
!dprint.jsonc

!.github/
!.github/**

!source/
!source/**
!tools/
!tools/**
!examples/
!examples/**
!docs/
!docs/**
!changelog-details/
!changelog-details/**

# Keep directory, ignore downloaded native binaries.
!native/
native/**
!native/.gitkeep

.dub/
dub.selections.json
*.exe
*.dll
*.lib
*.obj
*.pdb
*.exp
*.o
*.a
*.so
*.dylib
*.log
