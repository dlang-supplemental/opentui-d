/// Unload the native library. Safe to call multiple times.
void unloadLibrary()
{
    if (!loaded)
        return;
    version (Windows)
        FreeLibrary(cast(HMODULE) libHandle);
    else
        dlclose(libHandle);
    libHandle = null;
    loaded = false;
}
